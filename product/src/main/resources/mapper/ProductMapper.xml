<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.b2cmall.product.dao.mapper.ProductMapper">
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_sku(shop_id,category_id,name,description,stock,price,status,type,created_user_id,update_user_id)
        VALUES(#{shopId},#{categoryId},#{name},#{description},#{stock},#{price},0,#{type},#{createdUserId},#{updateUserId})
    </insert>
    <insert id="saveLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_sku_log(sku_id,stock,price,status,created_user_id,update_user_id)
        VALUES(#{skuId},#{stock},#{price},#{status},#{createdUserId},#{updateUserId})
    </insert>
    <select id="find" resultType="com.b2cmall.product.dao.po.SkuPO">
        SELECT id,shop_id AS shopId,category_id AS categoryId,name,description,stock,price,status,type,
               created_user_id AS createdUserId,update_user_id AS updateUserId,created_at AS createdAt,updated_at AS updatedAt
        FROM tb_sku WHERE id=#{id} AND shop_id=#{shopId}
    </select>
</mapper>

